# ─────────────────────────────────────────────────────────────────────────────
#  AI Platform Reliability Copilot v2.0 — Environment Configuration
#
#  Copy to .env and fill in values. Everything below works out of the box
#  with docker-compose — monitoring is ON, Redis is ON, LLM is mock by default.
#
#  To run with a real LLM:  set LLM_PROVIDER=groq and add GROQ_API_KEY
#  To run locally (no Docker): uvicorn backend.main:app --reload
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=local                   # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console              # console (local) | json (production)

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: mock | groq | openai | gemini | or a model name (e.g. gpt-oss-120b)
# When a model name is used, provider is inferred from whichever API key is set.
LLM_PROVIDER=mock

GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant   # Override the Groq model

OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default — zero config):
DATABASE_URL=sqlite+aiosqlite:///data/platform_reliability.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reliability_copilot

# ── Redis (ON by default in docker-compose) ────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# ── OpenTelemetry (ON by default — exposes /metrics for Prometheus) ────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=reliability-copilot

# OTLP endpoint — only needed if using an OTel Collector or Jaeger.
# In docker-compose this is set to the otel-collector service automatically.
# For local dev without docker-compose, leave blank (Prometheus exporter works standalone).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
AUTH_ENABLED=false
JWT_SECRET_KEY=dev-secret-change-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=60

# ── Alerting ───────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_MIN_SEVERITY=SEV-2
# PAGERDUTY_ROUTING_KEY=

# ── Grafana (docker-compose only) ─────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── SLO Configuration ──────────────────────────────────────────────────────────
# SLO_AVAILABILITY_TARGET=0.999     # 99.9%
# SLO_LATENCY_P95_MS=500.0

# ── Risk Score Weights (must sum to 1.0) ───────────────────────────────────────
# RISK_W_BLAST_RADIUS=0.25
# RISK_W_VELOCITY=0.20
# RISK_W_SLO_BURN=0.25
# RISK_W_HISTORICAL=0.15
# RISK_W_REVENUE=0.15
